# Environment variables for HDD App
# Copy this file to .env and fill in the values as needed.
# For local development, load it with: node --env-file=.env server.js
# On Railway, set these through the Railway dashboard instead.

# Port for the server (set automatically by Railway)
# PORT=3000

# Judge0 configuration (required for Run Samples)
#
# Option A – self-hosted Judge0 (uses X-Auth-Token):
# JUDGE0_URL=https://your-judge0-instance.example.com
# JUDGE0_API_KEY=your-judge0-token
#
# Option B – RapidAPI hosted Judge0 (uses X-RapidAPI-Key + X-RapidAPI-Host):
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your-rapidapi-key
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
#
# Kotlin language ID in Judge0 CE (78 = Kotlin, the default)
# JUDGE0_KOTLIN_LANGUAGE_ID=78
