# Environment variables for HDD App
# Copy this file to .env and fill in the values as needed.
# For local development, load it with: node --env-file=.env server.js
# On Railway, set these through the Railway dashboard instead.

# Port for the server (set automatically by Railway)
# PORT=3000

# Run Samples now compiles and runs Kotlin directly via a local kotlinc/java
# install (see localKotlinRunner.js and the Dockerfile) - no third-party
# execution API required or used by default.
#
# KOTLINC_BIN / JAVA_BIN only need setting if kotlinc/java aren't on PATH
# under their usual names (the Dockerfile puts kotlinc on PATH already):
# KOTLINC_BIN=/opt/kotlinc/bin/kotlinc
# JAVA_BIN=java

# --- Legacy Judge0 config (judge0.js) -----------------------------------
# No longer used by the Run Samples endpoint, kept only in case a working
# Judge0 subscription/instance becomes available again later.
#
# Option A – self-hosted Judge0 (uses X-Auth-Token):
# JUDGE0_URL=https://your-judge0-instance.example.com
# JUDGE0_API_KEY=your-judge0-token
#
# Option B – RapidAPI hosted Judge0 (uses X-RapidAPI-Key + X-RapidAPI-Host):
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your-rapidapi-key
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
#
# Kotlin language ID in Judge0 CE (78 = Kotlin, the default)
# JUDGE0_KOTLIN_LANGUAGE_ID=78

# Server-only Kotlin library imports (optional; defaults shown)
# KOTLIN_LIBRARY_REPOSITORY=enlorik/kotlin-cpp
# KOTLIN_LIBRARY_REF=main
# KOTLIN_LIBRARY_IMPORT=hdd.algos
